# 统一换行符，避免 Windows/Linux 协作产生整文件 diff
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.js   text eol=lf
*.css  text eol=lf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.mp3  binary
*.m4a  binary
*.db   binary
*.zip  binary
